# Contact form email (Resend: https://resend.com). Without these, the form logs enquiries in dev and shows an error in production.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "TES Website <website@tesmarine.com.ng>"
CONTACT_FROM_EMAIL=
# Where enquiries go (defaults to info@tesmarine.com.ng)
CONTACT_TO_EMAIL=
